prefix=
exec_prefix=
libdir=${pcfiledir}/../../../libavformat
includedir=src

Name: libavformat
Description: FFmpeg container format library
Version: 62.12.102
Requires:  libavcodec >= 62.28.102,  libswresample >= 6.3.102,  libavutil >= 60.26.102
Conflicts:
