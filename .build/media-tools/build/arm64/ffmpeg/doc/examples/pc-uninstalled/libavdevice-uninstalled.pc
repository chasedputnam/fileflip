prefix=
exec_prefix=
libdir=${pcfiledir}/../../../libavdevice
includedir=src

Name: libavdevice
Description: FFmpeg device handling library
Version: 62.3.102
Requires:  libavfilter >= 11.14.102,  libswscale >= 9.5.102,  libavformat >= 62.12.102,  libavcodec >= 62.28.102,  libswresample >= 6.3.102,  libavutil >= 60.26.102
Conflicts:
Libs: -L${libdir} -Wl,-rpath,${libdir} -lavdevice -lm
Cflags: -I${includedir}
