---
import '../styles/global.css';

const latestReleaseURL = 'https://github.com/chasedputnam/fileflip/releases/latest';
const faviconURL = `${import.meta.env.BASE_URL}/favicon.svg`;

const features = [
  {
    icon: 'rename',
    eyebrow: 'Invisible workflow',
    title: 'Rename it. That’s it.',
    body: 'Change the extension in Finder and File Flip detects the real file type, converts it, validates the result, and finishes the job automatically.',
  },
  {
    icon: 'shield',
    eyebrow: 'Private by design',
    title: 'Your files stay on your Mac.',
    body: 'No uploads, no remote conversion queue, and no file contents sent to a server. File Flip works locally—even when you’re offline.',
  },
  {
    icon: 'undo',
    eyebrow: 'Built for confidence',
    title: 'Every flip has an undo.',
    body: 'Choose to keep the original beside the conversion or use a recoverable backup. Conversion history keeps the safe next action close by.',
  },
];

const useCases = [
  ['Design handoff', 'Turn a heavy PNG into a shareable JPEG or modern WebP without opening an editor.', 'PNG', 'WEBP'],
  ['Presentation prep', 'Convert a client video to MP4 or extract clean audio before dropping it into a deck.', 'MOV', 'MP4'],
  ['Document sharing', 'Make office documents and markdown easier to send, review, or archive.', 'DOCX', 'PDF'],
  ['Audio workflow', 'Prepare recordings for editing, playback, or delivery in the format the next tool expects.', 'WAV', 'MP3'],
];

const formatGroups = [
  ['Images', 'JPEG, PNG, HEIC, WebP, TIFF, GIF, BMP'],
  ['Video', 'MP4, M4V, MOV, MKV, WEBM'],
  ['Audio', 'MP3, M4A, AAC, WAV, AIFF/AIF, FLAC, OGG, OPUS'],
  ['Documents', 'PDF, DOCX, ODT, TXT, Markdown, HTML'],
  ['Spreadsheets', 'XLSX, ODS, CSV'],
  ['Subtitles', 'SRT, VTT, ASS'],
];

const faqs = [
  ['How does File Flip know a file was renamed?', 'File Flip watches only folders you authorize. When an extension changes, it inspects the file contents instead of trusting the filename, then runs a conversion only when the source and requested formats differ and the pair is supported.'],
  ['Does File Flip overwrite the original?', 'You choose. “Keep original and create converted copy” leaves both files visible. “Replace file and keep recoverable backup” keeps Finder tidy while retaining an undoable original until your storage policy removes it.'],
  ['Does it upload files or require an account?', 'No. Conversion, validation, history, and undo happen locally on your Mac. File Flip does not upload file contents or metadata as part of those workflows.'],
  ['Which Macs are supported?', 'File Flip is built for macOS 15 or later on Apple Silicon. Some document conversions require a compatible local LibreOffice installation.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="File Flip converts files locally on your Mac when you change their filename extension in Finder." />
    <meta name="theme-color" content="#f6f1e5" />
    <link rel="icon" type="image/svg+xml" href={faviconURL} />
    <title>File Flip — Rename to convert on macOS</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="File Flip home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32"><path d="M7 6h12l6 6v14H7z"/><path d="M19 6v7h6"/><path d="m11 19 3 3 7-8"/></svg>
        </span>
        <span>File Flip</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#how">How it works</a>
        <a href="#use-cases">Use cases</a>
        <a href="#formats">Formats</a>
        <a href="#faq">FAQ</a>
      </nav>
      <a class="button button-small button-dark" href={latestReleaseURL}>Get File Flip <span aria-hidden="true">↗</span></a>
    </header>

    <main id="top">
      <section class="hero section-shell">
        <div class="hero-copy">
          <div class="eyebrow-pill"><span></span> A missing Mac feature... Now available!</div>
          <h1>Rename a file.<br /><em>Flip its format.</em></h1>
          <p class="hero-lede">File Flip turns a filename extension change into a real, local conversion. No export menus. No browser uploads. Just rename and keep moving.</p>
          <div class="hero-actions">
            <a class="button button-primary" href={latestReleaseURL}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.1 12.6c0-2.6 2.1-3.9 2.2-4-1.2-1.8-3.1-2-3.8-2-1.6-.2-3.2 1-4 1-.9 0-2.3-1-3.7-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.5 1.4 11.3.9 1.4 2 2.8 3.5 2.7 1.4-.1 2-.9 3.7-.9 1.7 0 2.2.9 3.7.9 1.5 0 2.5-1.4 3.4-2.7 1.1-1.6 1.5-3.1 1.5-3.2-.1 0-3.3-1.3-3.3-4.9ZM14.5 4.9c.8-1 1.4-2.5 1.2-3.9-1.2 0-2.7.8-3.6 1.8-.8.9-1.4 2.4-1.2 3.8 1.4.1 2.8-.7 3.6-1.7Z"/></svg>
              Get File Flip for Mac
            </a>
            <a class="text-link" href="#how">See how it works <span aria-hidden="true">↓</span></a>
          </div>
          <p class="compatibility">macOS 15+ · Apple Silicon Only · Works offline</p>
        </div>

        <div class="hero-visual" aria-label="File Flip converting a JPEG file into a PNG in Finder">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="finder-window">
            <div class="window-bar">
              <div class="traffic"><i></i><i></i><i></i></div>
              <span>Downloads</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="5"/><path d="m15 15 4 4"/></svg>
            </div>
            <div class="finder-body">
              <div class="sidebar-lines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
              <div class="file-grid">
                <div class="file-card muted-file"><span class="doc-icon tiny">PDF</span><span>Brief.pdf</span></div>
                <div class="file-card active-file">
                  <span class="image-icon"><i></i></span>
                  <span class="filename">product-shot.<strong>png</strong></span>
                </div>
                <div class="file-card muted-file"><span class="doc-icon tiny blue">DOC</span><span>Notes.docx</span></div>
              </div>
            </div>
          </div>
          <div class="rename-chip"><span>product-shot.jpg</span><b>→</b><span>product-shot.png</span></div>
          <div class="status-card">
            <span class="status-icon"><svg viewBox="0 0 24 24"><path d="m6 12 4 4 8-9"/></svg></span>
            <div><strong>Conversion complete</strong><span>JPEG → PNG · 0.8 sec</span></div>
            <span class="status-done">Done</span>
          </div>
        </div>
      </section>

      <section class="trust-strip" aria-label="File Flip principles">
        <div><svg viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5 3.4 8.2 8 10 4.6-1.8 8-5 8-10V6z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg><span><strong>100% local</strong>No cloud converter</span></div>
        <div><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4z"/><path d="m8 13 3-3 5 5 2-2"/></svg><span><strong>Format-aware</strong>Checks real contents</span></div>
        <div><svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 2-5.3"/><path d="M4 4v5h5"/></svg><span><strong>Recoverable</strong>History and undo</span></div>
        <div><svg viewBox="0 0 24 24"><path d="M6 4h12v16H6z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg><span><strong>Native Mac app</strong>Lives in your menu bar</span></div>
      </section>

      <section class="section section-shell" id="how">
        <div class="section-heading centered">
          <span class="kicker">Designed to disappear</span>
          <h2>The shortest path between two formats.</h2>
          <p>File Flip works where your files already live, making conversion feel like part of Finder instead of another task.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature, index) => (
            <article class="feature-card">
              <span class:list={['feature-number', `tone-${index + 1}`]}>0{index + 1}</span>
              <div class:list={['feature-icon', `tone-${index + 1}`]}>
                {feature.icon === 'rename' && <svg viewBox="0 0 28 28"><path d="M6 5h11l5 5v13H6z"/><path d="M17 5v6h5M10 17h8M14 13l4 4-4 4"/></svg>}
                {feature.icon === 'shield' && <svg viewBox="0 0 28 28"><path d="m14 3 9 4v6c0 6-3.8 9.8-9 12-5.2-2.2-9-6-9-12V7z"/><path d="m10 14 3 3 6-7"/></svg>}
                {feature.icon === 'undo' && <svg viewBox="0 0 28 28"><path d="M6 14a9 9 0 1 0 3-6.7"/><path d="M6 4v7h7"/></svg>}
              </div>
              <span class="card-eyebrow">{feature.eyebrow}</span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section section-shell workflow-section">
        <div class="workflow-copy">
          <span class="kicker">One tiny gesture</span>
          <h2>From “wrong format” to done in three steps.</h2>
          <ol class="steps">
            <li><span>1</span><div><strong>Pick a watched folder</strong><p>Authorize Desktop, Downloads, or any folder you choose.</p></div></li>
            <li><span>2</span><div><strong>Rename the extension</strong><p>Change <code>campaign.heic</code> to <code>campaign.jpg</code> in Finder.</p></div></li>
            <li><span>3</span><div><strong>Keep working</strong><p>File Flip converts, validates, and records the result in the background.</p></div></li>
          </ol>
        </div>
        <div class="menu-demo">
          <div class="desktop-bar"><span>●</span><span>File Flip</span><time>9:41 AM</time></div>
          <div class="menu-panel">
            <div class="menu-status"><span class="pulse"></span><div><strong>Monitoring</strong><small>2 folders watched</small></div><button aria-label="Pause monitoring">Ⅱ</button></div>
            <div class="menu-divider"></div>
            <span class="menu-label">RECENT ACTIVITY</span>
            <div class="activity"><span class="activity-icon green">✓</span><div><strong>campaign.jpg</strong><small>HEIC → JPEG · Just now</small></div><span>›</span></div>
            <div class="activity"><span class="activity-icon orange">↻</span><div><strong>interview.mp3</strong><small>WAV → MP3 · 2 min ago</small></div><span>›</span></div>
            <div class="menu-divider"></div>
            <div class="menu-links"><span>Open History</span><span>⌘H</span></div>
            <div class="menu-links"><span>Settings…</span><span>⌘,</span></div>
          </div>
          <span class="demo-note">Quiet when idle. Clear when you need it.</span>
        </div>
      </section>

      <section class="section use-case-section" id="use-cases">
        <div class="section-shell">
          <div class="section-heading split-heading">
            <div><span class="kicker light">Fits the work you already do</span><h2>Small conversions.<br />Big momentum.</h2></div>
            <p>File Flip takes the friction out of everyday format changes—whether you’re preparing a client handoff or cleaning up a personal archive.</p>
          </div>
          <div class="use-case-grid">
            {useCases.map(([title, body, from, to]) => (
              <article class="use-case-card">
                <div class="format-pair"><span>{from}</span><i>→</i><span>{to}</span></div>
                <h3>{title}</h3>
                <p>{body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section-shell formats-section" id="formats">
        <div class="formats-intro">
          <span class="kicker">One app, many formats</span>
          <h2>Ready for the files you meet every day.</h2>
          <p>Images, media, documents, spreadsheets, and subtitles all move through the same safe local workflow.</p>
          <a class="text-link" href="#faq">Questions about compatibility? <span>→</span></a>
        </div>
        <div class="format-list">
          {formatGroups.map(([name, formats], index) => (
            <div class="format-row">
              <span class:list={['format-badge', `badge-${index + 1}`]}>{name.slice(0, 2).toUpperCase()}</span>
              <div><strong>{name}</strong><span>{formats}</span></div>
            </div>
          ))}
          <p class="format-note">Format availability depends on the conversion direction and local provider support.</p>
        </div>
      </section>

      <section class="privacy-section">
        <div class="section-shell privacy-inner">
          <div class="privacy-graphic" aria-hidden="true">
            <span class="ring ring-a"></span><span class="ring ring-b"></span>
            <div class="mac-shape"><div class="mac-screen"><span class="lock"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><i></i><b>Your Mac</b></div><span class="stand"></span></div>
            <span class="file-float file-a">JPG</span><span class="file-float file-b">PDF</span><span class="file-float file-c">MP4</span>
          </div>
          <div class="privacy-copy">
            <span class="kicker light">Private by architecture</span>
            <h2>Your files don’t need a round trip through the internet.</h2>
            <p>File Flip performs conversion, validation, history, and undo on your Mac. It monitors only the folders you authorize and continues to work without a network connection.</p>
            <ul><li><span>✓</span> No file or metadata uploads</li><li><span>✓</span> No account required for conversion</li><li><span>✓</span> No surprise access outside watched folders</li></ul>
          </div>
        </div>
      </section>

      <section class="section section-shell faq-section" id="faq">
        <div class="faq-heading"><span class="kicker">A few useful details</span><h2>Questions, answered.</h2><p>File conversion should feel simple without hiding the safeguards underneath.</p></div>
        <div class="faq-list">
          {faqs.map(([question, answer], index) => (
            <details open={index === 0}>
              <summary>{question}<span aria-hidden="true"></span></summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="section-shell cta-section" id="download">
        <div class="cta-orbit"></div>
        <div class="cta-copy">
          <span class="kicker light">Less exporting. More doing.</span>
          <h2>Make file conversion feel native.</h2>
          <p>Bring safe, private, automatic conversions to Finder with File Flip.</p>
          <a class="button button-light" href={latestReleaseURL}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.1 12.6c0-2.6 2.1-3.9 2.2-4-1.2-1.8-3.1-2-3.8-2-1.6-.2-3.2 1-4 1-.9 0-2.3-1-3.7-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.5 1.4 11.3.9 1.4 2 2.8 3.5 2.7 1.4-.1 2-.9 3.7-.9 1.7 0 2.2.9 3.7.9 1.5 0 2.5-1.4 3.4-2.7 1.1-1.6 1.5-3.1 1.5-3.2-.1 0-3.3-1.3-3.3-4.9ZM14.5 4.9c.8-1 1.4-2.5 1.2-3.9-1.2 0-2.7.8-3.6 1.8-.8.9-1.4 2.4-1.2 3.8 1.4.1 2.8-.7 3.6-1.7Z"/></svg>
            Download latest release
          </a>
          <small>Built for macOS 14 and later</small>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M7 6h12l6 6v14H7z"/><path d="M19 6v7h6"/><path d="m11 19 3 3 7-8"/></svg></span><span>File Flip<small>Rename to convert.</small></span></a>
        <div class="footer-links"><a href="#how">How it works</a><a href="#use-cases">Use cases</a><a href="#formats">Formats</a><a href="#faq">FAQ</a></div>
        <p>© 2026 File Flip. Made for the Mac.</p>
      </div>
    </footer>
  </body>
</html>
